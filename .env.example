# Enable Telegram, Discord, or both. At least one token is required.
BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_COMMAND_PREFIX=!
# Direct Discord audio; no Java/Lavalink required. One voice channel globally by default.
DISCORD_MUSIC_BACKEND=direct
MUSIC_MAX_PLAYERS=1
FFMPEG_PATH=ffmpeg
# Only used with DISCORD_MUSIC_BACKEND=lavalink (optional legacy transport).
LAVALINK_ADDRESS=
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
DISCORD_LLM_SETTINGS_FILE=/app/data/discord-llm.json

# Docker image target:
# runtime      — yt-dlp, ffmpeg and local Whisper
# runtime-lite — yt-dlp and ffmpeg without the large Whisper/PyTorch layer
DOCKER_TARGET=runtime

# Instagram Apify fallback (used only when the public page hides media)
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=elis~instagram-downloader-api

# Donations
KOFI_URL=

# Link moderation and downloader limits
ALLOWED_LINKS_FILE=/app/data/allowed-links.json
LINK_MODERATION_FILE=/app/data/link-moderation.json
REDDIT_USER_AGENT=linux:nyande-bot:2.0
YTDLP_PATH=yt-dlp
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
MAX_MEDIA_ITEMS=50
MAX_FILE_SIZE=52428800
RETRY_ATTEMPTS=3
RETRY_DELAY=1.2
ADMIN_CACHE_TTL=60

# OpenAI/OpenRouter-compatible LLM for Telegram and Discord text conversations
LLM_ENABLED=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_SYSTEM_PROMPT=
LLM_COOLDOWN_SECONDS=0
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.6
LLM_MAX_HISTORY_MESSAGES=8
# Discord stores its separate history at this path plus .discord.
LLM_HISTORY_FILE=/app/data/llm-history.json
# Comma-separated words that invoke the bot in group chats.
LLM_TRIGGER_WORDS=мяу,мяяу
LLM_MEMORY_ENABLED=true
LLM_MEMORY_FILE=/app/data/llm-memory.db
LLM_MEMORY_MAX_PER_USER=100
LLM_MEMORY_RECALL_LIMIT=5
LLM_TIMEZONE=Asia/Almaty
LLM_WEB_SEARCH_ENABLED=false
LLM_WEB_SEARCH_MAX_RESULTS=5
LLM_VISION_ENABLED=true
LLM_VIDEO_FRAME_COUNT=3

# Chat message logging and search for LLM tools
CHAT_LOG_ENABLED=true
CHAT_LOG_FILE=/app/data/chatlog.db
CHAT_LOG_MAX_PER_CHAT=50000

# Local OpenAI Whisper CLI
WHISPER_ENABLED=false
WHISPER_PATH=whisper
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=auto

# Persistent per-chat quote collection
QUOTE_DB_FILE=.nyande-quotes.db
