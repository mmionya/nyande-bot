# Telegram bot token from @BotFather is required.
BOT_TOKEN=
# Comma-separated numeric user IDs. Only these owners can ban/unban users
# from all bot features across every chat (including DMs).
BOT_OWNER_IDS=
BANNED_USERS_FILE=/app/data/banned-users.json
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Docker image target:
# runtime      — yt-dlp, ffmpeg and local Whisper
# runtime-lite — yt-dlp and ffmpeg without the large Whisper/PyTorch layer
DOCKER_TARGET=runtime

# Instagram Apify fallback (used only when the public page hides media)
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=elis~instagram-downloader-api

# Donations
KOFI_URL=

# Link moderation and downloader limits
ALLOWED_LINKS_FILE=/app/data/allowed-links.json
LINK_MODERATION_FILE=/app/data/link-moderation.json
REDDIT_USER_AGENT=linux:nyande-bot:2.0
YTDLP_PATH=yt-dlp
# Optional account sessions. Anonymous download routes work with both empty.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
MAX_MEDIA_ITEMS=50
# Maximum size of an outgoing file, in bytes.
MAX_FILE_SIZE=52428800
# Oversized downloaded videos: H.264/AAC MP4, one compression at a time.
VIDEO_COMPRESSION_ENABLED=true
# Maximum source file size on disk, in bytes (default 300 MiB; range 1 KiB–2 GiB).
VIDEO_MAX_SOURCE_SIZE=314572800
# Positive limits in seconds; invalid or zero values use the defaults.
VIDEO_COMPRESSION_TIMEOUT_SECONDS=300
VIDEO_MAX_DURATION_SECONDS=600
RETRY_ATTEMPTS=3
RETRY_DELAY=1.2
ADMIN_CACHE_TTL=60

# OpenAI/OpenRouter-compatible LLM for Telegram text conversations
LLM_ENABLED=false
TELEGRAM_LLM_SETTINGS_FILE=/app/data/telegram-llm.json
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_SYSTEM_PROMPT=
LLM_COOLDOWN_SECONDS=0
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.6
LLM_MAX_HISTORY_MESSAGES=8
LLM_HISTORY_FILE=/app/data/llm-history.json
# Comma-separated words that invoke the bot in group chats.
LLM_TRIGGER_WORDS=мяу,мяяу
LLM_MEMORY_ENABLED=true
LLM_MEMORY_FILE=/app/data/llm-memory.db
LLM_MEMORY_MAX_PER_USER=100
LLM_MEMORY_RECALL_LIMIT=5
LLM_TIMEZONE=Asia/Almaty
LLM_WEB_SEARCH_ENABLED=false
LLM_WEB_SEARCH_MAX_RESULTS=5
# Send images (including embedded document pictures/PDF pages) to LLM_MODEL.
# The same model must support image input; no separate vision model is used.
LLM_VISION_ENABLED=true
LLM_VIDEO_FRAME_COUNT=3
# Optional dedicated Python interpreter for animated TGS stickers.
STICKER_PYTHON_PATH=python3

# Chat message logging and search for LLM tools
CHAT_LOG_ENABLED=true
CHAT_LOG_FILE=/app/data/chatlog.db
CHAT_LOG_MAX_PER_CHAT=50000
# Optional AES-256-GCM key for archived messages and LLM conversation history.
# Raw 32-byte key; mount separately from the data directory.
# Unix: mode 0600/0400. Windows: ACL limited to bot account, SYSTEM, Administrators.
# Back up the key separately. Existing plaintext data migrates at startup.
DATA_ENCRYPTION_KEY_FILE=

# Local voice/audio transcription; included in the default Docker runtime.
# Set false when using runtime-lite without Whisper.
WHISPER_ENABLED=true
WHISPER_PATH=whisper
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=auto

# Persistent quotes and reminders
QUOTE_DB_FILE=.nyande-quotes.db
REMINDER_DB_FILE=.nyande-reminders.db
